# エディタ共通のインデント・改行設定
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown は行末スペースが改行の意味を持つため削らない
[*.md]
trim_trailing_whitespace = false

# Capacitor が生成するネイティブ側は各言語の慣習に合わせる
[*.{java,kt,kts,gradle,swift,pbxproj,plist}]
indent_size = 4
