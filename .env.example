# Firebase クラウド同期の設定（クライアント公開前提の値。秘密ではない）
# Firebase コンソール → プロジェクト設定 → マイアプリ（Web）の firebaseConfig からコピー。
# 実際の値は .env.local に入れる（.gitignore 済み）。Vercel では Project Settings → Environment Variables に同じキーを登録。

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
